# markdown-magpie — local development template.
# Copy to .env and adjust. Used when running the apps directly (npm run dev:*),
# with Postgres reachable on localhost.
# .env is gitignored — never commit real keys.

# ── Core services ────────────────────────────────────────────────
# Postgres connection. REQUIRED. Postgres backs every store and the pg-boss job
# queue that all AI work runs through, so the API and watcher fail to start
# without it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/markdown_magpie

# Shared Postgres connection pool tuning for the API. Every store shares ONE pool
# (pg-boss keeps its own separate pool), so DB_POOL_MAX is the per-API-instance
# connection ceiling for application queries. Defaults shown; all optional.
# DB_POOL_MAX=10                 # max connections in the shared store pool
# DB_IDLE_TIMEOUT_MS=30000       # close a connection after it is idle this long
# DB_CONNECTION_TIMEOUT_MS=10000 # fail if a connection can't be acquired in time
# DB_STATEMENT_TIMEOUT_MS=30000  # server-side cap so a hung query can't pin a conn

# Browser-facing API URL for the Next.js web app.
#   NEXT_PUBLIC_API_BASE_URL is inlined at BUILD time (read by client code).
#   PUBLIC_API_BASE_URL is read at runtime by the server layout as a fallback.
# Leave both blank when the API is served from the same origin as the web app.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
PUBLIC_API_BASE_URL=

# Base URL the watcher, MCP server, and eval script use to reach the API.
# (The web app does NOT use this — it uses the *_PUBLIC_* vars above.)
API_BASE_URL=http://localhost:4000

# CORS allow-list for the API's Access-Control-Allow-Origin header. Unset or "*"
# (the default) allows any origin. In production set it to a comma-separated list
# of the web origin(s) allowed to call the API, e.g.
#   CORS_ALLOWED_ORIGINS=https://magpie.example.com
# CORS_ALLOWED_ORIGINS=*

# ── Auth: Auth0 or Microsoft Entra ID (FAILS CLOSED — required unless explicitly disabled) ──
# AUTH_REQUIRED gates token validation across the API and both MCP transports.
# It FAILS CLOSED: auth is REQUIRED by default and is only disabled when this is
# set EXACTLY to false. An unset, blank, or typo'd value leaves auth ON, so a
# misconfiguration can never silently expose the API. When auth is required the
# API refuses to start unless AUTH_AUDIENCE (a real identifier, not the
# placeholder below) and AUTH_ISSUER are set (or their legacy AUTH0_* names).
# For unauthenticated local development, opt out explicitly:
AUTH_REQUIRED=false
# Identity provider: auth0 (default) or entra (Microsoft Entra ID, single tenant).
# Anything else is a startup error. Entra setup: docs/authorization.md
# ("Using Microsoft Entra ID").
AUTH_PROVIDER=
# Token issuer, matched exactly against the token's `iss`.
#   auth0: https://your-tenant.eu.auth0.com (normalised to one trailing slash)
#   entra: https://login.microsoftonline.com/<tenant-id>/v2.0 (used verbatim)
# Legacy Auth0 fallbacks, still honoured when AUTH_ISSUER is unset:
# AUTH0_ISSUER_BASE_URL (full issuer), else AUTH0_DOMAIN (issuer derived as
# https://<domain>/). REQUIRED (one of them) when AUTH_REQUIRED is not false.
AUTH_ISSUER=
AUTH0_DOMAIN=
AUTH0_ISSUER_BASE_URL=
# API audience the tokens must carry (legacy fallback: AUTH0_AUDIENCE).
#   auth0: the Auth0 API identifier.
#   entra: the API app registration's Application (client) ID GUID (v2 `aud`).
# The AUTH0_AUDIENCE value below is a PLACEHOLDER: booting with auth enabled and
# this value is rejected. Replace it (or set AUTH_AUDIENCE) before enabling auth.
AUTH_AUDIENCE=
AUTH0_AUDIENCE=https://markdown-magpie.local/api
# Optional override for the JWKS endpoint (legacy fallback: AUTH0_JWKS_URI).
# Defaults: auth0 <issuer>/.well-known/jwks.json; entra
# https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys.
# AUTH_JWKS_URI=
# Optional override for the client-credentials token endpoint the watcher and
# HTTP MCP use for their own service tokens. Defaults: auth0 <issuer>/oauth/token;
# entra https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token.
# AUTH_TOKEN_URL=
# Entra only: the API's Application ID URI, used to build scope strings
# (client-credentials requests `<AUTH_API_ID_URI>/.default`). Defaults to
# api://<AUTH_AUDIENCE>.
# AUTH_API_ID_URI=
#
# Flow-scoped authorization (optional; see docs/authorization.md).
# AUTH_ROLES_CLAIM is the JWT claim key carrying the user's role names. auth0: the
# namespaced custom claim a post-login Action stamps (default below); entra: the
# app-role `roles` claim (default `roles`).
# AUTH_ROLES_CLAIM=https://magpie.wastedcake.com/roles
# KNOWLEDGE_ROLE_GRANTS maps role name -> flow id (or "*") -> capabilities
# (read|manage|ask|admin). Leaving it UNSET keeps flow-scoping inactive (the API
# behaves exactly as the global-scope-only model). Configuring it activates
# per-flow checks on proposals, gaps, ask, and the destructive /admin/reset.
# KNOWLEDGE_ROLE_GRANTS={"kb-hr-curators":{"hr":["read","manage"]},"kb-askers-all":{"*":["ask"]},"kb-super":{"*":["read","manage","ask","admin"]}}
# Web app (Next.js) SPA login settings — Auth0 or Microsoft Entra ID, both via
# a generic OIDC client (authorization code + PKCE, refresh tokens).
#
# For a DISTRIBUTABLE image, set the non-prefixed vars below. They are read at
# request time by the web server (layout.tsx renders force-dynamic) and injected
# into window.__MAGPIE_CONFIG__, so one prebuilt image can be configured per
# deployment with no rebuild. The provider, issuer and audience above
# (AUTH_PROVIDER, AUTH_ISSUER / AUTH0_ISSUER_BASE_URL / AUTH0_DOMAIN,
# AUTH_AUDIENCE / AUTH0_AUDIENCE) are reused; login is on when the issuer,
# client id and audience are all set. The legacy AUTH0_CLIENT_ID /
# AUTH0_REDIRECT_URI names still work as fallbacks.
#   auth0: the SPA application's client id. The console requests
#          `openid profile email offline_access` + the API scopes and sends
#          `audience` so Auth0 issues a JWT for the API.
#   entra: the SPA app registration's client id. The console requests
#          `openid profile offline_access` + `<AUTH_API_ID_URI>/<scope>` for each
#          API scope (AUTH_API_ID_URI defaults to api://<AUTH_AUDIENCE>).
# The browser always redirects (and returns after logout) to its own origin;
# AUTH_REDIRECT_URI is only an SSR fallback.
AUTH_CLIENT_ID=
AUTH_REDIRECT_URI=http://localhost:3000
#
# The NEXT_PUBLIC_* equivalents are OPTIONAL build-time overrides: when set
# during `next build` they are inlined into the bundle and take precedence over
# the runtime vars. Leave blank to keep the image generic and configure at
# runtime via the vars above. Legacy NEXT_PUBLIC_AUTH0_DOMAIN / _CLIENT_ID /
# _AUDIENCE / _REDIRECT_URI are still honoured as fallbacks.
NEXT_PUBLIC_AUTH_PROVIDER=
NEXT_PUBLIC_AUTH_ISSUER=
NEXT_PUBLIC_AUTH_CLIENT_ID=
NEXT_PUBLIC_AUTH_AUDIENCE=
NEXT_PUBLIC_AUTH_REDIRECT_URI=
NEXT_PUBLIC_AUTH_API_ID_URI=
# Public URL of the HTTP MCP endpoint (used in the OAuth protected-resource
# metadata). Match the externally reachable /mcp URL.
MCP_RESOURCE_URL=http://localhost:4001/mcp
# Endpoint the web "Connect over MCP" panel shows to users. Read at runtime from
# window.__MAGPIE_CONFIG__ (falls back to MCP_RESOURCE_URL, then localhost). The
# NEXT_PUBLIC_ form is an optional build-time inline override.
NEXT_PUBLIC_MCP_URL=
# Audience the HTTP MCP server validates inbound user tokens against. This is the
# MCP server's OWN Auth0 API identifier and is SEPARATE from AUTH_AUDIENCE (the
# web API). MCP clients request tokens via the RFC 8707 `resource` parameter, so
# Auth0 stamps aud = the /mcp URL; the server must validate that, not the web
# API audience. Defaults to MCP_RESOURCE_URL — only set this if the Auth0 API
# identifier differs from the public /mcp URL.
# Entra (AUTH_PROVIDER=entra): REQUIRED — the MCP app registration's client-ID
# GUID (v2 tokens carry aud = that GUID, never the URL). With Entra the HTTP MCP
# also refuses to start unless AUTH_ISSUER is set and MCP_RESOURCE_URL is https,
# has a path, and has no trailing slash (it is the MCP app's Application ID URI).
# See docs/mcp.md.
# MCP_AUDIENCE=
# Authorization server advertised in the MCP protected-resource metadata.
# Defaults: auth0 the issuer; entra
# https://login.microsoftonline.com/<tenant-id>/oauth21/2026-08 (derived from
# AUTH_ISSUER; enables Client ID Metadata Document clients without pre-registration).
# MCP_AUTHORIZATION_SERVER=
# Entra only: the MCP app's Application ID URI that advertised scopes are
# qualified with (<MCP_API_ID_URI>/read:knowledge, ...). Defaults to MCP_RESOURCE_URL.
# No trailing slash, quotes, backslashes or whitespace (checked at startup).
# MCP_API_ID_URI=
# Bearer token the stdio MCP transport presents to the API. Required when
# AUTH_REQUIRED=true (stdio MCP fails fast at startup otherwise).
MCP_AUTH_TOKEN=
# Downstream API service credential for the HTTP MCP transport (its own
# machine-to-machine identity; user tokens are validated locally and never
# forwarded). Provide ONE of the following when AUTH_REQUIRED=true (HTTP MCP
# fails fast at startup otherwise):
#
#   PREFERRED — client-credentials, fetched and refreshed at runtime so it
#   survives the token lifetime. The token is requested from AUTH_TOKEN_URL (the
#   provider default above) for the AUTH_AUDIENCE (web API) audience — for Entra,
#   the `<AUTH_API_ID_URI>/.default` scope. The MCP's M2M app needs the
#   act:on-behalf-of permission plus the scopes its tools use.
MCP_API_CLIENT_ID=
MCP_API_CLIENT_SECRET=
#
#   LEGACY — a static pre-minted access token. Simpler but EXPIRES (Auth0 default
#   24h); after expiry every tools/call fails until the token is replaced. Use
#   the client-credentials pair above instead for any long-running deployment.
MCP_API_AUTH_TOKEN=

# ── Storage backends (memory | postgres) ────────────────────────
# STORAGE_BACKEND is the default for every store.
STORAGE_BACKEND=postgres
# KNOWLEDGE_STORE must be "postgres" to enable semantic/hybrid retrieval
# (pgvector). Defaults to STORAGE_BACKEND when unset, as do the overrides below.
KNOWLEDGE_STORE=postgres
# QUESTION_LOG_STORE=
# PROPOSAL_STORE=
# Every other store has the same kind of override (memory | postgres, default
# STORAGE_BACKEND). They exist for tests and partial local setups; a real
# deployment sets STORAGE_BACKEND=postgres and leaves all of them unset:
#   KNOWLEDGE_CHANGE_STORE SCHEDULED_TASK_STORE SOURCE_SYNC_STORE PATROL_STORE
#   GAP_CLUSTER_STORE RECONCILIATION_DECISION_STORE MAINTENANCE_RUN_STORE
#   WATCHER_REGISTRY_STORE PR_CROSSLINK_STORE GAP_CLOSURE_VERIFICATION_STORE
#   SOURCE_MAP_STORE SOURCE_CONFLICT_STORE SEED_PLAN_STORE QUESTIONNAIRE_STORE
#   ASSERTED_CLAIMS_STORE QUESTIONNAIRE_IMPORT_STORE

# ── AI provider selection ────────────────────────────────────────
# All AI work runs on the queue: a watcher process completes AI jobs. The API
# never runs AI inline. AI_PROVIDER is mandatory and must name a watcher
# provider — startup fails if it is unset or unsupported.
# Valid: openai-compatible | azure-openai | codex | claude.
# The watcher must be configured with the matching provider's credentials.
# The embedding provider used for retrieval is auto-detected from its env vars;
# with no embedding provider configured, retrieval is keyword-only.
AI_PROVIDER=openai-compatible

# Optional token pricing, used to turn watcher-reported token usage into
# monetary cost. A JSON array with one entry per (provider, model) pair the
# watchers run; rates are per MILLION tokens in your billing currency. `model`
# is the configured model name (for azure-openai: the deployment name). Prices
# are operator-supplied because an endpoint can be OpenAI, OpenRouter, or a
# free local vLLM — no built-in table could be right. Unset = no cost
# reporting; a malformed value fails startup rather than mispricing silently.
# Example:
#   AI_PRICING=[{"provider":"openai-compatible","model":"gpt-4o-mini","inputPerMTok":0.15,"outputPerMTok":0.6}]
# AI_PRICING=

# -- Knowledge configuration ------------------------------------------------
# Configure your own Markdown knowledge sources and destinations. Leave these
# empty until you have a local folder or git repository to index.
# Example local setup:
#   KNOWLEDGE_SOURCES=[{"id":"docs","name":"Product Docs","path":"knowledge-bases/product"}]
#   KNOWLEDGE_DESTINATIONS=[{"id":"docs","name":"Product Docs","path":"knowledge-bases/product"}]
#   KNOWLEDGE_FLOWS=[{"id":"docs","name":"Product Docs","sourceIds":["docs"],"destinationId":"docs"}]
# A flow may also carry:
#   "persona"        — answering voice, injected into the answer prompt
#   "routingSummary" — the flow's topical scope, used ONLY to route questions to it by
#                      embedding similarity (see FLOW_ROUTER_* below). With ≥2 flows a
#                      good summary is what lets routing pick this flow — the name alone
#                      is usually too thin. Example:
#   KNOWLEDGE_FLOWS=[{"id":"ops","name":"Ops","sourceIds":["ops"],"destinationId":"ops","routingSummary":"deployments, on-call, incidents, and rollbacks"}]
# A git source or destination may override the default PAT (GITHUB_TOKEN /
# AZURE_DEVOPS_PAT) for a repo held by a different account. Add "tokenEnv" — the
# NAME of an env var holding that repo's PAT (never the secret itself). The name
# travels through job payloads and the execution context; each process (API and
# watcher) reads the actual token from its OWN environment, so set that env var on
# BOTH. Example: a destination pushed with a bot account's token —
#   KNOWLEDGE_DESTINATIONS=[{"id":"ops","name":"Ops","url":"https://github.com/other-org/ops-docs.git","tokenEnv":"OPS_DOCS_PAT"}]
#   OPS_DOCS_PAT=ghp_...
KNOWLEDGE_SOURCES=[]
KNOWLEDGE_DESTINATIONS=[]
KNOWLEDGE_FLOWS=[]
# Managed clone root for git-backed sources/destinations (synced at API startup).
MAGPIE_CHECKOUT_ROOT=.magpie/checkouts
# Where the API writes per-flow snapshots (gaps/proposals/PR state read back by the
# reconciler and /snapshots page). Like MAGPIE_CHECKOUT_ROOT, a relative default
# resolves under the process working directory — in a container that is the
# read-only /app, so point this at a writable, mounted path in deployments.
MAGPIE_SNAPSHOT_ROOT=.magpie/snapshots
# Legacy fallbacks, used only when KNOWLEDGE_SOURCES/DESTINATIONS are unset.
# KNOWLEDGE_REPOSITORIES=
# KNOWLEDGE_REPO_PATH=
# Legacy single-value aliases, still accepted (first one set wins, in this order):
#   sources:      KNOWLEDGE_SOURCES > KNOWLEDGE_SOURCE > SOURCE_DATA > SOURCE
#   destinations: KNOWLEDGE_DESTINATIONS > KNOWLEDGE_DESTINATION > DESTINATION
#   flows:        KNOWLEDGE_FLOWS > KNOWLEDGE_FLOW
# Prefer the plural names above in new configuration.
# Root that a client-supplied local index path must stay inside (path-traversal
# guard for local-folder indexing). Defaults to the process working directory.
# MAGPIE_LOCAL_INDEX_ROOT=
# Cap on the changed files one source-sync run considers per source; the true
# total is still recorded on the run so truncation is visible.
# SOURCE_SYNC_MAX_CHANGED_FILES=1000
# A flow with sources but fewer indexed documents than this is offered an
# auto-proposed seed plan by the hourly seed_bootstrap job.
# SEED_BOOTSTRAP_MAX_DOCS=3

# -- Job queue (API side) ─────────────────────────────────────────
# All AI work runs through the pg-boss job queue in Postgres. Clients
# POST a job, receive 202, then block on GET /api/jobs/:id/wait (200 once
# terminal, otherwise 202 — keep polling). These tune that flow.
# JOB_WAIT_TIMEOUT_MS bounds how long a single /wait call blocks before
# returning 202 so the client can re-issue it. JOB_WAIT_POLL_MS is the
# server-side poll cadence while a /wait call is in flight.
JOB_WAIT_TIMEOUT_MS=25000
JOB_WAIT_POLL_MS=250
# Timezone applied to scheduled (cron) jobs registered with pg-boss.
JOB_SCHEDULE_TIMEZONE=UTC
# One informed repair-reprompt for a schema-invalid output of a repairable job
# type before it terminal-fails. On by default; set EXACTLY to false to make
# every schema-invalid output terminal-fail immediately.
# MAGPIE_JOB_REPAIR_ENABLED=false
# What happens to a field a completed job's output carries but its job
# contract (packages/jobs/src/schemas.ts) does not declare. Unset/false (the
# production default) strips the field and logs a warning, so a model emitting
# one stray field never fails a paid generation. true makes it a hard job
# failure — set on BOTH the API and the watcher by the test context and the
# e2e/eval harnesses so a prompt or runner emitting an undeclared field fails
# before it ships. Leave unset in production.
# MAGPIE_JOB_OUTPUT_STRICT=false

# ── Rate limiting & AI cost controls ─────────────────────────────
# Per-principal request throttling plus a global cap on concurrent metered AI
# work. On by default; set RATE_LIMIT_ENABLED=false to disable both. The
# per-principal limiter keys on the authenticated subject, so it is inert when
# auth is disabled (there is no principal to attribute requests to). See
# docs/rate-limiting.md for the log-event schema and Grafana queries.
# RATE_LIMIT_ENABLED=false          # kill switch for L1 + L2 (default: enabled)
RATE_LIMIT_WINDOW_MS=60000          # fixed-window width shared by both tiers
RATE_LIMIT_ASK_PER_WINDOW=30        # /ask + /retrieve, per principal per window
RATE_LIMIT_TRIGGER_PER_WINDOW=5     # manual run/index triggers, per principal
# When a request has no principal, key the limiter on the left-most
# X-Forwarded-For entry instead of the socket peer. The header is
# client-spoofable: set to true ONLY behind a trusted reverse proxy.
# RATE_LIMIT_TRUST_FORWARDED_FOR=true
# Global ceiling on in-flight (created|retry|active) AI jobs; /ask returns 429
# once this many are already running (admission control, not a queue-and-wait).
AI_MAX_INFLIGHT_JOBS=20
# In-flight slots reserved for interactive AI jobs (answer_question,
# outline_flow_seed): /ask is rejected only when this many interactive jobs are
# already in flight AND the global ceiling is reached, so maintenance-patrol
# bursts can never starve live asks. 0 disables the reserve; values above
# AI_MAX_INFLIGHT_JOBS are clamped to it.
AI_INTERACTIVE_RESERVED_JOBS=5
# Maintenance fan-out controls (#288b). A single patrol/reconciler/sync tick may
# enqueue at most MAX_AI_JOBS_PER_TICK AI jobs (a per-tick budget under the global
# ceiling; kept <= AI_MAX_INFLIGHT_JOBS - AI_INTERACTIVE_RESERVED_JOBS); beyond it
# the tick defers work and re-enters next tick. When a tick defers/rejects at least
# FANOUT_ALERT_DEFERRED enqueues its maintenance_fanout log event is flagged runaway.
MAINTENANCE_MAX_AI_JOBS_PER_TICK=12
MAINTENANCE_FANOUT_ALERT_DEFERRED=20

# ── Flow router (embedding-first, chat fallback) ─────────────────
# Abstain-biased cosine cut-offs for POST /api/route, which picks a flow by
# embedding similarity before falling back to a chat completion. The top flow must
# clear MIN_SCORE and beat the runner-up by MIN_MARGIN, else the router abstains and
# the watcher uses the chat router. A mis-tune only costs savings, never routing
# correctness (abstaining reproduces the pre-embedding behaviour). Both are floats in
# [0,1]; blank/out-of-range falls back to the defaults shown.
FLOW_ROUTER_MIN_SCORE=0.25
FLOW_ROUTER_MIN_MARGIN=0.05

# ── Gap reconciler phase-1 assignment ────────────────────────────
# Cosine floor a new gap must clear against an active cluster's representative
# embedding to join it (and for two new gaps to seed one shared cluster).
# Deliberately conservative: it collapses only near-identical rewordings;
# subtler consolidation stays with the reshape critic. Re-tune with
# `npm run eval:gap-threshold` (e.g. after changing the embedding model).
# Float in (0,1]; blank/out-of-range falls back to the default shown.
GAP_CLUSTER_ASSIGN_THRESHOLD=0.84

# ── Questionnaires (docs/questionnaires.md) ──────────────────────
# Defaults shown; all optional. Blank/out-of-range values fall back to the default.
# QUESTIONNAIRE_MATCH_THRESHOLD=0.84     # cosine floor for "same question re-asked", float in (0,1]
# QUESTIONNAIRE_MAX_INFLIGHT=3           # items one questionnaire keeps in the answer pipeline at once
# QUESTIONNAIRE_RECONCILE_CANDIDATES=3   # top-N approved matches fed to the reconcile step
# QUESTIONNAIRE_RECONCILE_ENABLED=0      # NOTE: only the literal 0 disables it (not "false");
#                                        # 0 falls back to the legacy deterministic-veto path

# ── Watcher (polls the API and completes AI jobs) ────────────────
# A watcher advertises a capability only when its required env vars are set
# (see the provider sections below). The API never runs AI inline — without a
# matching watcher running, jobs stay queued.
WATCHER_NAME=local-dev-watcher
# How often the watcher polls the API for a claimable job.
WATCHER_POLL_INTERVAL_MS=2000
# API side: how long a watcher may stay silent before the Jobs screen stops
# listing it as connected. Default 15 min.
# WATCHER_ACTIVE_WINDOW_MS=900000
# Abort deadline for the maintenance orchestration callbacks (reconcile-gaps,
# source-sync, fix-patrol, improve-patrol). These API endpoints bounded-wait on a
# batch of AI jobs and legitimately run for minutes, so they get a far longer
# deadline than the hot-path request timeout. Default 15 min; raise toward the
# maintenance job's 1-hour budget for very large patrol batches. Optional.
# WATCHER_MAINTENANCE_TIMEOUT_MS=900000
# Health/liveness HTTP endpoint the watcher serves (GET /health, GET /ready) so
# orchestrators can detect a wedged worker. /health returns 503 if the poll loop
# hasn't ticked within WATCHER_HEALTH_STALE_AFTER_MS. All optional — defaults shown.
# WATCHER_HEALTH_PORT=4002          # port for the watcher health server (1-65535)
# WATCHER_HEALTH_HOST=0.0.0.0       # bind address (0.0.0.0 for container health probes)
# WATCHER_HEALTH_STALE_AFTER_MS=120000  # mark /health stale if no loop tick within this window
# Per-request timeout for hosted-API chat calls (openai-compatible / azure).
AGENT_API_TIMEOUT_MS=120000
# Sampling temperature for hosted-API chat calls (openai-compatible / azure).
# Leave unset to send 0.2. Set to `default` to omit the field entirely — REQUIRED
# for reasoning deployments (GPT-5-class, o-series), which accept only their own
# default and reject any explicit value with HTTP 400. A number overrides 0.2.
# CHAT_TEMPERATURE=default
# Service credential the watcher uses to authenticate to the API. Required when
# AUTH_REQUIRED=true — otherwise every /api/jobs/claim returns 401 and the
# watcher crash-loops. The M2M app must be authorised for the AUTH_AUDIENCE API
# with the manage:jobs, ask:knowledge, read:knowledge and manage:knowledge
# permissions (Entra: application permissions / app roles). The provider, token
# endpoint and audience are derived from the AUTH_* (or legacy AUTH0_*) vars above.
#
#   PREFERRED — client-credentials, fetched and refreshed at runtime so it
#   survives the ~24h Auth0 token lifetime.
WATCHER_API_CLIENT_ID=
WATCHER_API_CLIENT_SECRET=
#   LEGACY — a static pre-minted access token (API_TOKEN). Simpler but EXPIRES;
#   after expiry every claim 401s until it is replaced. Prefer the pair above for
#   any long-running deployment. Used only when the pair is unset.
# API_TOKEN=

# ── OpenAI-compatible chat ───────────────────────────────────────
# A watcher advertises the `openai-compatible` capability only when all three
# are set.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# OpenAI-compatible embeddings (hybrid retrieval). The model must emit at most
# 1536 dimensions; narrower vectors (384, 768) are zero-padded to the stored
# width, which leaves cosine similarity and every tuned threshold unchanged.
# Base URL/key fall back to the chat values above when blank — only set these
# when embeddings live on a different endpoint than chat (e.g. DeepSeek for
# chat, OpenAI for embeddings).
#
# The API key is OPTIONAL: an unauthenticated endpoint (a local embeddings
# server such as Ollama, LM Studio or Hugging Face TEI, or an internal service
# on a trusted network) is a supported configuration — a base URL and a model
# are enough. The API warns at startup when embeddings run unauthenticated.
OPENAI_COMPATIBLE_EMBEDDING_BASE_URL=
OPENAI_COMPATIBLE_EMBEDDING_API_KEY=
OPENAI_COMPATIBLE_EMBEDDING_MODEL=
# Optional output width, sent as the `dimensions` request parameter — leave
# BLANK unless the model documents support for it. text-embedding-3-small and
# -large shorten natively at full quality (set 1536 to fit the stored width);
# ada-002 and most local servers, including the Ollama sidecar, reject the
# field outright, which is why it is never sent unless set.
OPENAI_COMPATIBLE_EMBEDDING_DIMENSIONS=
#
# For a local Ollama (`ollama pull nomic-embed-text`, or the bundled compose
# `embeddings` profile — see .env.compose.example), leave the key blank and use:
#   OPENAI_COMPATIBLE_EMBEDDING_BASE_URL=http://localhost:11434/v1
#   OPENAI_COMPATIBLE_EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_TIMEOUT_MS=60000
# Cold CPU inference is slower than a hosted endpoint, hence the raised timeout.

# ── Azure OpenAI (alternative to OpenAI-compatible) ──────────────
# A watcher advertises the `azure-openai` capability when ENDPOINT, API_KEY and
# CHAT_DEPLOYMENT are all set. EMBEDDING_DEPLOYMENT enables Azure embeddings for
# retrieval; API_VERSION has the default shown below.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Optional output width, sent as the `dimensions` request parameter only when
# set. REQUIRED for a text-embedding-3-large deployment: it returns 3072
# dimensions by default, wider than the stored 1536, and indexing fails until
# you set this to 1536. Leave blank for ada-002, which rejects the field.
AZURE_OPENAI_EMBEDDING_DIMENSIONS=
AZURE_OPENAI_API_VERSION=2024-10-21

# ── Git provider credentials ─────────────────────────────────────
# GITHUB_TOKEN (github.com) and AZURE_DEVOPS_PAT (dev.azure.com / *.visualstudio.com)
# authenticate HTTPS clone/fetch/pull/push when set — required to publish branches
# from a container with no ambient git credentials. The token is matched to the
# remote's host and passed via the environment (never the URL or command line). A
# credential-embedded URL or SSH remote bypasses these and is used as-is.
# A specific source/destination can override these host defaults with a per-repo PAT
# via its "tokenEnv" config (see the Knowledge configuration section above) — the
# override applies to clone/fetch/push AND the GitHub PR create/comment/poll calls.
# GIT_PROVIDER is display-only (defaults to "local").
GIT_PROVIDER=local
# Leave GITHUB_TOKEN blank to use your GitHub CLI login instead: if `gh auth login`
# has been run, the API and watcher read `gh auth token` at startup and use it as
# GITHUB_TOKEN. An explicit GITHUB_TOKEN always wins. Set MAGPIE_GH_CLI_AUTH=false
# to turn the fallback off (e.g. on a shared host where gh is logged in as a person).
GITHUB_TOKEN=
MAGPIE_GH_CLI_AUTH=
# Identity used for commits created by "Publish branch". REQUIRED — publishing
# fails fast if either is unset (no fallback identity is assumed). Set both in any
# environment that publishes branches, including containers without ambient git config.
# A watcher advertises the `github` capability only when GITHUB_TOKEN,
# MAGPIE_GIT_AUTHOR_NAME and MAGPIE_GIT_AUTHOR_EMAIL are all set.
MAGPIE_GIT_AUTHOR_NAME=
MAGPIE_GIT_AUTHOR_EMAIL=
# Git subprocess / GitHub API limits, read by whichever process runs git (API and
# watcher). Defaults shown; all optional.
# GIT_TIMEOUT_MS=120000            # per git subprocess
# GIT_MAX_BUFFER_BYTES=67108864    # git stdout/stderr buffer (64 MiB)
# GITHUB_API_TIMEOUT_MS=30000      # per GitHub REST/GraphQL call
# GIT_PARTIAL_CLONE=true           # blobless partial clones; set false (0/off/no) for a
#                                  # remote that mishandles --filter (a rejected filter
#                                  # already falls back to a full clone automatically)
# Publishing a GitHub-hosted proposal also opens a pull request when GITHUB_TOKEN
# is set; other hosts fall back to a branch-only publish. The "Pull request status
# refresh" runs as a scheduled maintenance job (pg-boss cron) that watches open
# PRs and advances proposals when they merge (resolve gaps + re-index) or close.
AZURE_DEVOPS_PAT=

# ── External agent CLIs (codex / claude watcher providers) ───────
# A watcher advertises the `codex` capability when CODEX_CLI_PATH is set and the
# `claude` capability when CLAUDE_CLI_PATH is set; both default to a bare command
# name resolved on PATH. On Windows, point *_CLI_PATH at a directly-spawnable
# executable (e.g. claude.exe) — a .cmd/.ps1 PATH shim fails to spawn.
# Environment isolation (neutral cwd, empty/read-only toolset, no MCP servers, no
# user/project settings) is appended in code AFTER these args and cannot be
# configured away — see "CLI environment isolation" in docs/ai-jobs.md.
CODEX_CLI_PATH=codex
CODEX_CLI_ARGS=exec
# Prompt delivery: `arg` passes the prompt as a CLI argument; `stdin` pipes it in.
# Use `stdin` on Windows — retrieval-augmented prompts exceed the ~32 KB command
# line limit and fail with `spawn ENAMETOOLONG` in `arg` mode.
CODEX_CLI_PROMPT_MODE=arg
# Optional model name. When set, `--model <value>` is appended to the CLI args
# (the flag codex and claude share). Leave blank to use the CLI's own default.
CODEX_CLI_MODEL=
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_ARGS=-p
CLAUDE_CLI_PROMPT_MODE=arg
CLAUDE_CLI_MODEL=
# Per-invocation timeout for agent CLI runs.
AGENT_CLI_TIMEOUT_MS=120000
# Timeout for source-grounded agentic runs (CLI checkout exploration) — minutes, not seconds.
# Keep below the draft_seed_document queue expiration (900s) so a run cannot outlive its lease.
MAGPIE_AGENTIC_TIMEOUT_MS=600000
# Grace period a cancelled CLI job is given to exit before it is killed.
CLI_CANCEL_GRACE_MS=5000
# Spawned agent CLIs receive a minimal env allowlist, NOT the watcher's full
# environment (see "CLI environment isolation" in docs/ai-jobs.md): non-secret
# operational vars (PATH/HOME/locale/proxy/CA) plus only the CLI's own provider
# credential (ANTHROPIC_* for claude; OPENAI_API_KEY/OPENAI_BASE_URL/CODEX_HOME
# for codex). List extra variable names here (comma/space separated) to forward
# them too — e.g. Bedrock/Vertex creds or a nonstandard credential var.
MAGPIE_CLI_ENV_PASSTHROUGH=

# ── Optional tunables (defaults shown; uncomment to override) ────
# LOG_LEVEL=info                  # api/watcher/mcp log verbosity: trace|debug|
#                                 # info|warn|error|fatal (default: info in
#                                 # production, debug otherwise). Structured JSON.
# PORT=4000                       # API listen port (web uses 3000 via next)
# ANSWER_POLL_INTERVAL_MS=1000    # MCP: poll cadence while awaiting an answer
# ANSWER_TIMEOUT_MS=120000        # MCP: give up waiting for an answer after this
# OUTLINE_POLL_INTERVAL_MS=1500   # MCP: poll cadence while awaiting a seed outline
# OUTLINE_TIMEOUT_MS=180000       # MCP: give up waiting for a seed outline after this
# MCP_HTTP_PORT=4001              # HTTP MCP transport listen port
# MCP_HTTP_HOST=127.0.0.1         # HTTP MCP bind address (compose sets 0.0.0.0)
# EMBEDDING_TIMEOUT_MS=60000      # API: per-request timeout for embedding calls
# API_SHUTDOWN_DRAIN_MS=10000     # API: max wait for background work on SIGTERM/SIGINT
# LOG_STARTUP_CONFIG=false        # API: skip the resolved-configuration log at startup
#                                 # (on by default; secrets are always masked)
# NODE_ENV=production             # production => JSON logs at info; otherwise pretty
#                                 # logs at debug. Set by the Docker image.
# MAGPIE_DEV_API_PROXY=http://localhost:4000  # web dev server only: proxy same-origin
#                                 # /api/* to a local API (avoids CORS in local dev)
# NEXT_DIST_DIR=                  # web: Next.js output dir (default .next-build in
#                                 # production, .next-dev otherwise)
# EVAL_TIMEOUT_MS=30000           # scripts/eval-api.ts request timeout

# ── Observability / OpenTelemetry (optional; OFF by default) ─────
# Telemetry turns on only when an OTLP endpoint is set. Export is OTLP, so point
# it at any backend (Grafana/Tempo, Datadog, Honeycomb, Sentry) or an OTel
# Collector. The SDK reads the standard OTEL_* vars directly.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318  # enables telemetry when set
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer xxx  # e.g. backend auth
# OTEL_SERVICE_NAME=                 # overrides the default (api / watcher)
# MAGPIE_TELEMETRY_ENABLED=false     # force-disable even when an endpoint is set

# ── Set by the build, not by operators ───────────────────────────
# MAGPIE_BUILD_SHA / MAGPIE_BUILD_COMMIT_MESSAGE / MAGPIE_BUILD_COMMITTED_AT are
# baked into the Docker image from the GIT_SHA / GIT_COMMIT_MESSAGE /
# GIT_COMMITTED_AT build args and shown as the console's build status. Unset in
# local dev (the console then shows a "Development" build).
#
# The complete, grouped reference for every variable is docs/configuration.md.
